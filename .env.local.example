RESEND_API_KEY=
CONTACT_TO_EMAIL=adriangch95@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 — ID de medición público (G-...).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Instagram feed (see README "Feed de Instagram" for how to get these)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Supabase — el formulario de contacto crea el lead directo en ARCHI.OS
# (lib/supabase/admin.ts). Mismo proyecto que usa la instancia de
# ARCHI.OS (repo separado, ver README). Project ref en supabase/config.toml
# de ese repo; valores desde el dashboard de Supabase (Project Settings >
# API).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ARCHI.OS — organización que recibirá los leads de este sitio público.
# Debe ser el UUID de "Adrián Gutiérrez Arquitectura" en Supabase.
ARCHIOS_ORGANIZATION_ID=
WEBSITE_REVALIDATE_SECRET=
