RESEND_API_KEY=
CONTACT_TO_EMAIL=adriangch95@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Instagram feed (see README "Feed de Instagram" for how to get these)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Supabase — ARCHI.OS dashboard (see ARCHITECTURE.md). Project ref lives
# in supabase/config.toml once linked; values below come from the
# Supabase dashboard (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 + Search Console — /dashboard/website (Fase 5, see
# INTEGRATION_SETUP.md). Same service account covers both.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# WhatsApp Business Cloud API — lib/integrations/whatsapp.ts (Fase 6)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google Calendar OAuth client — lib/integrations/google-calendar.ts
# (Fase 6; el flujo de autorización en si no esta implementado todavia)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Archi AI — app/api/ai/chat/route.ts (Fase 7). API key gratuita desde
# https://ai.google.dev (Google AI Studio) — sin proyecto de GCP ni
# facturación. Ver INTEGRATION_SETUP.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Google Maps — mapa de clientes/proyectos (/dashboard/map) y
# geocodificacion de direcciones. Requiere un proyecto de Google Cloud
# con facturacion habilitada (a diferencia de la key de Gemini de
# arriba). Dos keys distintas — ver INTEGRATION_SETUP.md:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: navegador, restringida por referrer
#   HTTP al dominio de produccion; habilita "Maps JavaScript API".
# GOOGLE_MAPS_SERVER_API_KEY: servidor (geocoding), sin restriccion de
#   referrer; habilita "Geocoding API".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
